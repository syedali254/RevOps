# B2B Lead Engine — environment template
# Copy to `.env` and fill in values. `.env` is gitignored. NEVER put these in frontend code.

# --- Local app ---
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Absolute path is optional; defaults to <backend>/b2b_lead_engine.db
# DATABASE_URL=sqlite:///./b2b_lead_engine.db

# --- Safety ---
# The prototype is dry-run only. This must remain true.
DRY_RUN=true

# --- Discovery connectors (live) ---
# Tavily Search API — web search for candidate companies (LIVE)
# Sign up: https://tavily.com/
# Free tier: 1000 searches/month
TAVILY_API_KEY=

# Brave Search API — web search for candidate companies (FIXTURE MODE ONLY)
# Sign up: https://api-dashboard.search.brave.com/
# Pricing: check current terms before use (free tier may have limitations)
# Kept for fallback/fixture mode only
BRAVE_API_KEY=

# --- Enrichment connectors ---
# GNews API — news and funding enrichment
# Sign up: https://gnews.io/
# Free tier: 100 req/day, 12-hour delay
GNEWS_API_KEY=

# OpenCorporates API — business registry data
# Sign up: https://opencorporates.com/
OPENCORPORATES_API_KEY=

# --- Future AI provider (NOT required for Milestone 3; leave empty) ---
# AI_PROVIDER=
# AI_API_KEY=
